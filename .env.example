# --- Required ---
# From @BotFather on Telegram
BOT_TOKEN=
# 32-byte hex key that encrypts every user's wallet key. Generate: npm run genkey
# Losing it = losing every bot-created wallet. Leaking it + the database = losing every user's funds.
MASTER_KEY=

# --- Network ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
REF_CONTRACT_ID=ref-finance-101.testnet
WRAP_CONTRACT_ID=wrap.testnet

# --- Market data (GeckoTerminal, mainnet prices) ---
GECKO_BASE_URL=https://api.geckoterminal.com/api/v2
GECKO_NETWORK=near

# --- Optional ---
# Comma-separated Telegram user IDs. Empty = anyone can use the bot.
ALLOWED_USER_IDS=
# Testnet account that sends new wallets a little NEAR so they work straight away
FUNDER_ACCOUNT_ID=
FUNDER_PRIVATE_KEY=
FUNDER_AMOUNT_NEAR=1
# Limits
MAX_TRADE_NEAR=50
MAX_LEVERAGE=10
SLIPPAGE_PCT=1
PAPER_START_USD=10000
MONITOR_INTERVAL_SEC=300
DB_PATH=./data/bot.db

# --- AI agent (optional) ---
# Without a key the bot still works, on rules only. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Cheaper model for short trade alerts
AI_FAST_MODEL=claude-haiku-5-5
# Max AI replies per user per day (cost control)
AI_DAILY_LIMIT=60
# on/off: let the AI search the web for token news (billed per search)
AI_WEB_SEARCH=on
