# --- Required ---
# From @BotFather on Telegram
BOT_TOKEN=
# 32-byte hex key that encrypts every user's wallet key. Generate: npm run genkey
# Losing it = losing every bot-created wallet. Leaking it + the database = losing every user's funds.
MASTER_KEY=

# --- Network ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
REF_CONTRACT_ID=ref-finance-101.testnet
WRAP_CONTRACT_ID=wrap.testnet

# --- Market data (GeckoTerminal, mainnet prices) ---
GECKO_BASE_URL=https://api.geckoterminal.com/api/v2
GECKO_NETWORK=near

# --- Optional ---
# Comma-separated Telegram user IDs. Empty = anyone can use the bot.
ALLOWED_USER_IDS=
# Testnet account that sends new wallets a little NEAR so they work straight away
FUNDER_ACCOUNT_ID=
FUNDER_PRIVATE_KEY=
FUNDER_AMOUNT_NEAR=1
# Limits
MAX_TRADE_NEAR=50
MAX_LEVERAGE=10
SLIPPAGE_PCT=1
PAPER_START_USD=10000
MONITOR_INTERVAL_SEC=300
DB_PATH=./data/bot.db

# --- AI agent (optional) ---
# Without a key the bot still works, on rules only. Set ONE of these:
#  NEAR AI Cloud (https://cloud.near.ai): pay per token, private inference. Claude models are "anthropic/claude-..."
NEAR_AI_API_KEY=
#  Anthropic directly (https://console.anthropic.com). Only this provider has live web search.
ANTHROPIC_API_KEY=
#  Or any OpenAI-compatible API (OpenRouter, Groq, Gemini...): set AI_PROVIDER=openai, AI_BASE_URL and AI_API_KEY
# AI_PROVIDER=openai
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# If several keys are set, NEAR AI wins; force one with AI_PROVIDER=anthropic|nearai|openai
AI_MODEL=claude-sonnet-5-5
# Cheaper model for short trade alerts
AI_FAST_MODEL=claude-haiku-5-5
# Max AI replies per user per day (cost control)
AI_DAILY_LIMIT=60
# on/off: let the AI search the web for token news (billed per search)
AI_WEB_SEARCH=on

# --- Trade reports and news ---
# Every N hours, traders with open trades get a report: trend, 24h odds, news and (with AI) options. 0 = off.
# Each user can change theirs with /report <hours> or /report off.
REPORT_INTERVAL_HOURS=4
# Comma-separated RSS feeds for headlines (free, no key). Leave unset for the defaults:
# Cointelegraph, Decrypt, The Block, CoinDesk
# NEWS_FEEDS=
