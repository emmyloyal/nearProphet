{
  "name": "near-trade-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "genkey": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "dotenv": "^18.0.10",
    "grammy": "^1.46.0",
    "near-api-js": "^7.5.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
